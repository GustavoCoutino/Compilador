programa patito4;

vars { x, y: entero; r: flotante; }

nula saludar() {
    escribe("hola, mundo!");
};

entero suma(a: entero, b: entero) {
    retorno a + b;
};

inicio
{
    x = -5;
    y = suma(10, 20);
    r = 1.5e-3;

    si (x == y) {
        escribe("iguales");
    } sino {
        escribe("dif: ", x, " vs ", y);
    };

    mientras (x != 0) haz {
        si (x > 0) {
            escribe("pos");
        };
        x = x - 1;
    };

    [
        saludar();
        escribe("dentro de bloque");
    ]
}
fin
